{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": [".claude/skills/impeccable/**", "eval/tasks/**"],
  "ignoreBinaries": ["agnix", "gitleaks", "lefthook"],
  "workspaces": {
    ".": {
      "entry": ["scripts/*.ts", "design/src/screens.mjs"]
    },
    "packages/*": {
      "project": ["src/**/*.ts"]
    },
    "apps/*": {
      "project": ["src/**/*.{ts,tsx,css}", "*.ts", "*.js"]
    },
    "packages/tools": {
      "entry": ["src/**/*.fixture.ts"],
      "project": ["src/**/*.ts"]
    }
  }
}
